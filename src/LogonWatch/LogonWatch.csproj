<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>logonwatch</AssemblyName>
    <RootNamespace>LogonWatch</RootNamespace>
    <Version>1.0.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- every public type and member needs a doc comment: a missing one fails the build -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Samples\attack.jsonl" LogicalName="LogonWatch.Samples.attack.jsonl" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LogonWatch.Tests" />
  </ItemGroup>

</Project>
