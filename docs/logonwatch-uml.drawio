unded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.75;" edge="1" parent="1" source="prog" target="report"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e20" value="printed by" style="endArrow=open;endSize=12;dashed=1;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="report" target="writer"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;Design notes&lt;/b&gt;&lt;br&gt;&amp;bull; Every source turns its input into the same LogonEvent, so the rules never know where data came from.&lt;br&gt;&amp;bull; One sliding-window algorithm (Bursts) serves every rule, in linear time.&lt;br&gt;&amp;bull; Only events from Microsoft-Windows-Security-Auditing are trusted; look-alikes are ignored.&lt;br&gt;&amp;bull; Read-only: nothing is written except the report." style="shape=note;whiteSpace=wrap;html=1;size=16;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="1110" width="620" height="96" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;dashed open arrow = uses / creates&lt;br&gt;dashed hollow triangle = implements an interface&lt;br&gt;+ public &amp;nbsp; - private" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffffff;strokeColor=#999999;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="680" y="1110" width="330" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
