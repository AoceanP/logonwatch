<mxfile host="app.diagrams.net"><diagram id="Program flow" name="Program flow"><mxGraphModel dx="1380" dy="1700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1380" pageHeight="1700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;logonwatch&lt;/b&gt; &amp;mdash; program flow" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="620" y="20" width="400" height="30" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;oval = start / end &amp;nbsp; rounded box = step&lt;br&gt;diamond = decision &amp;nbsp; slanted box = output&lt;br&gt;red / orange = alert severity" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffffff;strokeColor=#999999;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="620" y="60" width="330" height="80" as="geometry"/></mxCell><mxCell id="start" value="Start&lt;br&gt;&lt;i&gt;logonwatch &amp;lt;input&amp;gt; [options]&lt;/i&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="180" y="20" width="240" height="60" as="geometry"/></mxCell><mxCell id="parse" value="&lt;b&gt;OptionsParser.Parse&lt;/b&gt;&lt;br&gt;one input, valid settings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="185" y="110" width="230" height="55" as="geometry"/></mxCell><mxCell id="dUse" value="valid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="225" y="195" width="150" height="80" as="geometry"/></mxCell><mxCell id="usage" value="Print error + usage&lt;br&gt;exit 2" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="-5" y="210" width="170" height="55" as="geometry"/></mxCell><mxCell id="dHelp" value="--help or&lt;br&gt;--version?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="215" y="310" width="170" height="85" as="geometry"/></mxCell><mxCell id="help" value="Print and exit 0" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="440" y="325" width="160" height="50" as="geometry"/></mxCell><mxCell id="dIn" value="input?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="225" y="430" width="150" height="80" as="geometry"/></mxCell><mxCell id="live" value="&lt;b&gt;--live&lt;/b&gt;&lt;br&gt;Security log (admin)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="545" width="180" height="55" as="geometry"/></mxCell><mxCell id="file" value="&lt;b&gt;--file&lt;/b&gt;&lt;br&gt;exported .evtx" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="215" y="545" width="170" height="55" as="geometry"/></mxCell><mxCell id="jsonl" value="&lt;b&gt;--jsonl&lt;/b&gt;&lt;br&gt;JSON-lines file" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="415" y="545" width="170" height="55" as="geometry"/></mxCell><mxCell id="demo" value="&lt;b&gt;--demo&lt;/b&gt;&lt;br&gt;built-in scenario" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="615" y="545" width="170" height="55" as="geometry"/></mxCell><mxCell id="xml" value="&lt;b&gt;SecurityEventParser&lt;/b&gt;&lt;br&gt;XPath 4624/4625, trust only&lt;br&gt;Security-Auditing provider" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="75" y="650" width="240" height="70" as="geometry"/></mxCell><mxCell id="dErr" value="read&lt;br&gt;error?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="225" y="760" width="150" height="85" as="geometry"/></mxCell><mxCell id="err" value="Print message&lt;br&gt;exit 1" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="10" y="775" width="160" height="55" as="geometry"/></mxCell><mxCell id="since" value="Keep events within &lt;b&gt;--since&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="185" y="880" width="230" height="55" as="geometry"/></mxCell><mxCell id="dRed" value="--redact?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="225" y="965" width="150" height="80" as="geometry"/></mxCell><mxCell id="red" value="&lt;b&gt;Redactor&lt;/b&gt;&lt;br&gt;user-1, ip-1 ..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="977" width="180" height="55" as="geometry"/></mxCell><mxCell id="prep" value="&lt;b&gt;Detector.Prepare&lt;/b&gt;&lt;br&gt;drop SYSTEM, services, PC$ accounts;&lt;br&gt;sort by time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="160" y="1080" width="280" height="70" as="geometry"/></mxCell><mxCell id="rules" value="&lt;b&gt;Run the 5 rules&lt;/b&gt;&lt;br&gt;(sliding windows and payload patterns)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="160" y="1190" width="280" height="60" as="geometry"/></mxCell><mxCell id="sort" value="Sort alerts: most severe first" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="185" y="1290" width="230" height="55" as="geometry"/></mxCell><mxCell id="out" value="&lt;b&gt;ReportWriter&lt;/b&gt;&lt;br&gt;text, or JSON with --json" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="175" y="1380" width="250" height="60" as="geometry"/></mxCell><mxCell id="dAl" value="any&lt;br&gt;alerts?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="225" y="1480" width="150" height="85" as="geometry"/></mxCell><mxCell id="ex3" value="exit 3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="1495" width="120" height="55" as="geometry"/></mxCell><mxCell id="ex0" value="exit 0" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="240" y="1600" width="120" height="55" as="geometry"/></mxCell><mxCell id="g_rules" value="The 5 detection rules" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=2;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="820" y="1060" width="520" height="480" as="geometry"/></mxCell><mxCell id="r1" value="&lt;b&gt;success after failures&lt;/b&gt;&lt;br&gt;a logon works right after 5+ failures&lt;br&gt;(same source or account, 10 min)&lt;br&gt;&lt;b&gt;CRITICAL&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="835" y="1100" width="250" height="85" as="geometry"/></mxCell><mxCell id="r2" value="&lt;b&gt;brute force&lt;/b&gt;&lt;br&gt;10+ failures from one source&lt;br&gt;in 5 min" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1100" y="1100" width="220" height="85" as="geometry"/></mxCell><mxCell id="r3" value="&lt;b&gt;password spray&lt;/b&gt;&lt;br&gt;one source, 5+ different&lt;br&gt;accounts in 10 min" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="835" y="1210" width="250" height="85" as="geometry"/></mxCell><mxCell id="r4" value="&lt;b&gt;distributed attack&lt;/b&gt;&lt;br&gt;one account, 5+ different&lt;br&gt;sources in 10 min" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1100" y="1210" width="220" height="85" as="geometry"/></mxCell><mxCell id="r5" value="&lt;b&gt;injection attempt&lt;/b&gt;&lt;br&gt;the user name is an attack payload: SQL injection,&lt;br&gt;command injection, Log4Shell, script tags" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="850" y="1320" width="470" height="75" as="geometry"/></mxCell><mxCell id="rnote" value="Overlapping windows merge, so one attack gives one alert. Local failures (typed at the keyboard) are Low." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="840" y="1420" width="480" height="50" as="geometry"/></mxCell><mxCell id="fe0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="start" target="parse"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fe1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundCo